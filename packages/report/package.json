{
  "name": "@ku-utils/report",
  "version": "1.2.14",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队通用埋点上报 SDK（CoreTracker + 工厂封装）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@ku-utils/utils": "workspace:*"
  },
  "devDependencies": {
    "@ku-utils/eslint-config": "workspace:*",
    "@ku-utils/tsconfig": "workspace:*",
    "eslint": "^9.27.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  }
}
