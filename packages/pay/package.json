{
  "name": "@ku-utils/pay",
  "version": "1.1.17",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队 Web 支付 SDK（HelaPay：匿名登录 / SKU / 下单 / 微信 JSAPI 支付）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ku-utils/utils": "workspace:*",
    "js-md5": "^0.8.3"
  },
  "devDependencies": {
    "@ku-utils/eslint-config": "workspace:*",
    "@ku-utils/tsconfig": "workspace:*",
    "eslint": "^9.27.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
