{
  "name": "@ku-utils/v2-custom-columns",
  "version": "1.0.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "Vue 2 自定义列组件库 — schema + v-for 驱动，支持多套配置持久化、拖拽排序、分组导航",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "peerDependencies": {
    "vue": ">=2.6.0 <3.0.0",
    "element-ui": ">=2.15.0",
    "vuedraggable": ">=2.24.0"
  },
  "dependencies": {
    "@ku-utils/utils": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "element-ui": "^2.15.14",
    "less": "^4.2.0",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16",
    "vuedraggable": "^2.24.3",
    "vite": "^6.3.5"
  }
}
