{
  "name": "@ku-utils/ui",
  "version": "1.2.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队 Vue 3 业务组件库",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ku-utils/eslint-config": "workspace:*",
    "@ku-utils/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.27.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  }
}
