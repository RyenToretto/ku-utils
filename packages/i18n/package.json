{
  "name": "@ku-utils/i18n",
  "version": "1.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队多语言工具",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "skills",
    "scripts",
    "rules",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@ku-utils/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.16"
  }
}
