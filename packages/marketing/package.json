{
  "name": "@ku-utils/marketing",
  "version": "1.4.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队营销追踪与渠道归因（Adjust / Appsflyer / Landing / App 下载）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto-import": {
      "types": "./dist/auto-import.d.ts",
      "import": "./dist/auto-import.js",
      "require": "./dist/auto-import.cjs"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-auto-import.mjs && tsup",
    "build:only": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ku-utils/utils": "workspace:*"
  },
  "devDependencies": {
    "@ku-utils/eslint-config": "workspace:*",
    "@ku-utils/tsconfig": "workspace:*",
    "eslint": "^9.27.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
