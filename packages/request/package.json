{
  "name": "@ku-utils/request",
  "version": "1.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队 HTTP 请求封装（基于 Axios）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@ku-utils/tsconfig": "workspace:*",
    "@ku-utils/types": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
