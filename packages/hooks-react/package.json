{
  "name": "@ku-utils/hooks-react",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils React Hooks（useMaxHeight / useVersionUpdate）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@ku-utils/utils": "workspace:*"
  },
  "devDependencies": {
    "@ku-utils/tsconfig": "workspace:*",
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
