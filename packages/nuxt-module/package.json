{
  "name": "@ku-utils/nuxt-module",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils Nuxt 4 集成模块",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "nuxt": "^3.17.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@ku-utils/directives": "workspace:*",
    "@ku-utils/hooks": "workspace:*",
    "@ku-utils/skin": "workspace:*",
    "@nuxt/kit": "^3.17.3"
  },
  "devDependencies": {
    "@ku-utils/tsconfig": "workspace:*",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.17.3",
    "nuxt": "^3.17.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.16"
  }
}
