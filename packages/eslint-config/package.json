{
  "name": "@ku-utils/eslint-config",
  "version": "1.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队共享 ESLint 配置",
  "type": "module",
  "exports": {
    "./base": "./dist/base.js",
    "./vue2": "./dist/vue2.js",
    "./vue3": "./dist/vue3.js",
    "./nuxt4": "./dist/nuxt4.js"
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "eslint-plugin-vue": "^10.2.0",
    "typescript-eslint": "^8.32.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "eslint-plugin-import-x": "^4.12.2",
    "globals": "^16.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  }
}
