{
  "name": "@ku-utils/eslint-config",
  "version": "1.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "ku-utils 团队共享 ESLint 配置（Vue 2 / Vue 3 / Nuxt 4 / Angular）",
  "type": "module",
  "exports": {
    "./base": "./dist/base.js",
    "./vue2": "./dist/vue2.js",
    "./vue3": "./dist/vue3.js",
    "./nuxt4": "./dist/nuxt4.js",
    "./angular": "./dist/angular.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "eslint-plugin-vue": "^10.2.0",
    "typescript-eslint": "^8.32.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "eslint-plugin-import-x": "^4.12.2",
    "globals": "^16.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "angular-eslint": "^22.5.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "angular-eslint": "^22.5.0"
  },
  "peerDependenciesMeta": {
    "angular-eslint": {
      "optional": true
    }
  }
}
