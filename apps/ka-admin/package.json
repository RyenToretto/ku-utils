{
  "name": "@ku-utils/ka-admin",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "description": "Angular 22 + ng-zorro-antd 管理端 starter，workspace 消费 @ku-utils/*",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "ng serve --host 0.0.0.0",
    "predev": "pnpm run prepare:assets",
    "build": "ng build",
    "prebuild": "pnpm run prepare:assets",
    "prepare:assets": "node ./scripts/generate-static-version.mjs && node ./scripts/generate-zorro-theme.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "lint": "eslint src esbuild"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ant-design/icons-angular": "^22.1.1",
    "@ku-utils/a-custom-columns": "workspace:*",
    "@ku-utils/hooks-angular": "workspace:*",
    "@ku-utils/skin": "workspace:*",
    "@ku-utils/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "ng-zorro-antd": "^22.1.1",
    "nprogress": "^0.2.0",
    "qs": "^6.14.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@ku-utils/eslint-config": "workspace:*",
    "@ku-utils/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.18",
    "angular-eslint": "^22.5.0",
    "esbuild": "0.28.2",
    "eslint": "^9.27.0",
    "jiti": "^2.7.0",
    "less": "^4.9.0",
    "sass": "^1.100.0",
    "typescript": "~6.0.3"
  }
}
