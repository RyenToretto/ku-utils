{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ka-admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "ka",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-esbuild:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/nprogress/nprogress.css",
              "src/assets/styles/generated/ng-zorro-ku.css",
              "node_modules/@ku-utils/a-custom-columns/style.css",
              "node_modules/@ku-utils/skin/dist/index.css",
              "src/assets/styles/zorro-ku-bridge.scss",
              "src/assets/styles/index.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/modules/_example/_router/index.ts",
                  "with": "src/stubs/empty-example-routes.ts"
                },
                {
                  "replace": "src/modules/_example/_maps/index.ts",
                  "with": "src/stubs/empty-example-maps.ts"
                },
                {
                  "replace": "src/layouts/header-example-tab-entry.ts",
                  "with": "src/stubs/empty-example-nav-tab.ts"
                }
              ],
              "plugins": [
                {
                  "path": "./esbuild/forbid-example-in-bundle.ts",
                  "options": {
                    "enabled": true,
                    "replaced": [
                      "src/modules/_example/_router/index.ts",
                      "src/modules/_example/_maps/index.ts",
                      "src/layouts/header-example-tab-entry.ts"
                    ]
                  }
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-esbuild:dev-server",
          "options": {
            "port": 3444,
            "middlewares": ["./esbuild/mock-middleware.ts"],
            "proxyConfig": "esbuild/proxy.conf.mjs",
            "prebundle": {
              "exclude": ["@ku-utils/a-custom-columns", "@ku-utils/hooks-angular"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "ka-admin:build:production"
            },
            "development": {
              "buildTarget": "ka-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
