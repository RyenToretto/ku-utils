{
  "name": "@ku-utils/kv2-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Vue 2.7 + Element UI 管理端 starter，与 kv3-admin 1:1 双生，workspace 消费 @ku-utils/*",
  "scripts": {
    "ensure-vue-demi": "node ./scripts/ensure-vue-demi-vue27.mjs",
    "dev": "vite --host",
    "predev": "node ./scripts/ensure-vue-demi-vue27.mjs && node ./scripts/generate-static-version.mjs",
    "prebuild": "node ./scripts/ensure-vue-demi-vue27.mjs && node ./scripts/generate-static-version.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ku-utils/skin": "workspace:*",
    "@ku-utils/ui-vue2": "workspace:*",
    "@ku-utils/utils": "workspace:*",
    "@ku-utils/v2-custom-columns": "workspace:*",
    "axios": "^1.17.0",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.21",
    "echarts": "^5.6.0",
    "element-ui": "^2.15.14",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.36",
    "qs": "^6.14.0",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@ku-utils/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.18",
    "@vitejs/plugin-vue2": "^2.3.3",
    "playwright-core": "^1.63.0",
    "sass": "^1.100.0",
    "vite": "^6.3.5",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^2.2.8"
  }
}
